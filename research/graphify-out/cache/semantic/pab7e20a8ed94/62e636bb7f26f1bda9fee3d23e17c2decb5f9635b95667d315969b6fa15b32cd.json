{"nodes": [{"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_gram", "label": "Gradient Routed Auxiliary Modules (GRAM)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L20,L44-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds per-domain auxiliary neurons to each MLP; routes updates by data label (sometimes freezing general weights) so deleting a module removes a capability; approximates many data-filtered models in one run."}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_modular_pretraining_access_control", "label": "Modular Pretraining Enables Access Control (paper/blog, Jul 2026)", "file_type": "paper", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L1-24", "source_url": null, "captured_at": null, "author": "Ethan Roland, Murat Cubuktepe, Erick Martinez, et al. (AE Studio, Anthropic)", "contributor": null, "rationale": "Preliminary; not applied to Anthropic production models."}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_capability_level_access_control", "label": "Capability-Level Access Control", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L28-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refusals/classifiers are jailbreakable behavioral layers; tiered access is coarse; separate filtered models are too expensive."}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_data_filtering", "label": "Data Filtering (baseline)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L30,L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_lora_baseline", "label": "LoRA Adapter Baseline", "file_type": "concept", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fine-tunes filtered model to add dual-use capabilities back; strong baseline, but summing adapters degrades performance."}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_maxent", "label": "MaxEnt Unlearning", "file_type": "concept", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L70-72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recovers near baseline under malicious fine-tuning: suppresses rather than removes capabilities."}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_prior_work", "label": "Prior Work: DEMix layers, SGTM, Gradient Routing, NULLs", "file_type": "concept", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L32,L100", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_compute_ratio", "label": "Compute Ratio Metric", "file_type": "concept", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute-adjusted loss: fraction of all-data baseline training needed to reach same loss."}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_simplestories_experiment", "label": "SimpleStories Topic Isolation Experiment (26M)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/anthropic_blog_modular_pretraining.md", "source_location": "L56-62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_anthropic_blog_modular_pretraining_dual_use_experiment", "label": "Real Dual-Us