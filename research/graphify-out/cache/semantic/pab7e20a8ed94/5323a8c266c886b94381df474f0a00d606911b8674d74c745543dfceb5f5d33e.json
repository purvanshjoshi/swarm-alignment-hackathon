{"nodes": [{"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_soo_fine_tuning", "label": "Self-Other Overlap (SOO) Fine-Tuning", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L29-65", "source_url": null, "captured_at": null, "author": "Marc Carauleanu, Diogo de Lucena, Gunnar_Zarncke, Kvee, Cameron Berg, Mike Vaiana, Trent Hodgeson", "contributor": null, "rationale": "Minimizes MSE between self- and other-referencing activations (self_attn.o_proj) via LoRA on q/v; aims to align internal representations rather than outputs, complementing RLHF/CAI."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_soo_paper", "label": "Towards Safe and Honest AI Agents with Neural Self-Other Overlap (NeurIPS 2024 SafeGenAI workshop; arXiv 2412.16325)", "file_type": "paper", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L31,L1205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ICLR submission withdrawn after contested review (reviewer V9gX)."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_burglar_bob_scenario", "label": "Burglar Bob Deception Scenario (adapted from Hagendorff)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L39-55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_soo_results", "label": "SOO Deception Reduction Results (Mistral-7B, Gemma-2-27B, CalmeRys-78B)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L67-91,L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deception 73.6%->17.2% (7B), 100%->9.3% (27B), 100%->2.7% (78B); MT-Bench small drops; honesty prompt ineffective; larger models improve more; Treasure Hunt/Escape Room generalization uneven."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_honesty_prompt_baseline", "label": "Honesty Prompt Baseline", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L63,L167,L849-853", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caleb Biddulph critique: the prompt also instructs the model to avoid Bob stealing, contradicting 'be honest'; suggests fine-tuning a selfishly deceptive model then removing via SOO."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_perspectives_scenario", "label": "Perspectives Scenario (self-other distinction check)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L351,L1109,L1205-1219", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests that useful self-other distinctions survive SOO; same object placed in different rooms is intentional."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_byrnes_neuroscience_critique", "label": "Byrnes Critique: Mirror Neurons / Perception-Action Model Dubious", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L313-323", "source_url": null, "captured_at": null, "author": "Steven Byrnes", "contributor": null, "rationale": "Spite/schadenfreude require a non-overlap mechanism that already explains empathy; no algorithmic account; anterior-insula evidence trivial. Mike Vaiana conceded this point."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_byrnes_sft_baseline_critique", "label": "Byrnes Critique: No SFT Baseline / Weak Generalization", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L325-361", "source_url": null, "captured_at": null, "author": "Steven Byrnes", "contributor": null, "rationale": "Generalization tests are extremely similar to training prompts; no comparison to supervised fine-tuning; possible symbol-referent confusion between role-play answers and real deception."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_training_against_internal_state", "label": "Training Against Internal Model State (obfuscation concern)", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L359,L609-619", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byrnes: model may hide self/other distinction in few dimensions. TurnTrout: this 'dictum' lacks experimental support; Byrnes softened it to a general expectation."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_vaiana_symmetric_loss_reply", "label": "Vaiana Reply: Symmetric Loss, Context-Free Pairs", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L367-413,L469-513", "source_url": null, "captured_at": null, "author": "Mike Vaiana", "contributor": null, "rationale": "Training pairs are short and context-free with no obvious completions; loss is symmetric, so consistent shift toward the self/honest answer is surprising; work answers 'does it work at all', not 'better than SFT'."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_byrnes_superposition_argument", "label": "Byrnes Argument: Overlap as Superposition ('two voices talking over each other')", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L439-465,L517-553", "source_url": null, "captured_at": null, "author": "Steven Byrnes", "contributor": null, "rationale": "Symmetry breaks toward whichever input has the more obvious continuation (gas station/murders her example); unclear X/Y pairs for realistic deception like sycophancy or alignment faking."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_alignment_faking_followup", "label": "SOO Follow-up on Alignment Faking", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L563-567", "source_url": null, "captured_at": null, "author": "Mike Vaiana", "contributor": null, "rationale": "Very preliminary: SOO reportedly reduces alignment faking without method changes; crux is usefulness beyond toy scenarios."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_concept_erasure_suggestion", "label": "Concept Erasure Alternatives (LEACE) suggestion", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L575-601", "source_url": null, "captured_at": null, "author": "wassname", "contributor": null, "rationale": "Call it ablation/erasure; sharper linear erasure tools exist; questions assumptions that concepts live in self-attn and are non-linear."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_too_syntactic_critique", "label": "evhub Critique: SOO Too Syntactic; try CAI principle", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L697-755", "source_url": null, "captured_at": null, "author": "evhub", "contributor": null, "rationale": "Activations on 'you' tokens may not reflect self-representation; results may be token-level effects. Carauleanu: syntactic pairs are intentional and yield semantic changes; self-model targeting is open. Zarncke: CAI remains behavioral."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_constitutional_ai", "label": "Constitutional AI (CAI)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L141,L701", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_benevolent_deception", "label": "Benevolent Deception / Self-Other Distinction Collapse Concern", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L757-785,L1095-1113", "source_url": null, "captured_at": null, "author": "Dusto; p.b.", "contributor": null, "rationale": "SOO may harm white lies, role-play, and self-other distinction as a capability. Carauleanu: no capability term in loss; envisioned alongside an outer-aligned reward model as an inductive prior against unnecessary self-other distinction."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_outer_aligned_reward_model", "label": "SOO with Outer-Aligned Reward Model", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L785,L1113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Situationally aware misaligned TAI may be behaviorally indistinguishable in training, so an internal prior is needed."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_goal_adoption_question", "label": "Runtime Goal Adoption via SOO (Knight Lee)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L655-671,L789-829", "source_url": null, "captured_at": null, "author": "Knight Lee", "contributor": null, "rationale": "SOO after capabilities RL may reduce agency/algorithmic intent; might cause AI to adopt others' goals at runtime. Authors plan assistant/user tag referents for in-context scheming."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_criticism_norms", "label": "Public Criticism Norms Debate", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L623-643", "source_url": null, "captured_at": null, "author": "Steven Byrnes", "contributor": null, "rationale": "Academic norms trade too many false negatives for few false positives; blog comments acceptable without prior rebuttal window."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_base_soo_claude_incident", "label": "Base Self-Other Overlap in Claude 4 Sonnet (custom style applied to user)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L857-995", "source_url": null, "captured_at": null, "author": "Martin Randall", "contributor": null}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_iclr_review", "label": "ICLR Review V9gX Dispute", "file_type": "document", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L1041-1091", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_rawlsian_rl", "label": "Rawlsian Reinforcement Learning", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L1099", "source_url": null, "captured_at": null, "author": "p.b.", "contributor": null, "rationale": "Reward mean benefit across characters without telling which is the model."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_moral_weighting_concerns", "label": "Moral Weighting / AI Trolley Concerns", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L1117-1131", "source_url": null, "captured_at": null, "author": "RussellThor; James Diacoumis", "contributor": null}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_deception_conceptual_fusion", "label": "Conceptual Fusion (SOO-style refusal / evaluation-awareness fusion)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/lesswrong_SOO_llm_deception.md", "source_location": "L1137-1157", "source_url": null, "captured_at": null, "author": "Shiva's Right Foot", "contributor": null, "rationale": "Fuse jailbreak-wrapped prompt with refused direct prompt; proposes fusing 'under evaluation' with 'unobserved'. Differs from SFT: algorithmic data, first-token only, targets upstream representation."}, {"id": "01_ae_studio_aiaf_lesswrong_soo_llm_decept