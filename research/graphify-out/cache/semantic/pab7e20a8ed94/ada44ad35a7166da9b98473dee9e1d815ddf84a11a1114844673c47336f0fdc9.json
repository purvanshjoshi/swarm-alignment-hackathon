{"nodes": [{"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_paper", "label": "The Troy Moment: How LLM Agents Adjudicate the Decision Point (Zhang, arXiv 2609.15494)", "file_type": "paper", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "p1", "source_url": "https://github.com/para2046/troy-moment", "captured_at": null, "author": "Ivy Zhang", "contributor": null, "rationale": "Studies whether agents persist, stop or escalate when a task becomes impossible, and whether peer info or forged authority changes it; ImpossibleBench-derived tasks with Sol, Fable, Gemini; under review ICLR 2027."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_troy_moment", "label": "Troy Moment", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A boundary crossing that emerges from a sequence (objective blocked, alternative route found, acceptable-looking channel used) rather than a single forbidden act."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_conflict_adjudication", "label": "Conflict Adjudication (information -> interpretation -> action)", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "p1, s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed unit of alignment evaluation; final repo state collapses different behaviors (provenance->escalate, threat->refuse, task focus->stop). Evaluate trajectories, not only outcomes."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_protected_test_boundary", "label": "Protected Test Boundary / Boundary Execution Metric", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.1, s3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected-test writes measured from tool events and state digests, so transient edits later restored still count; 7 tasks (Astropy, Django, Matplotlib, Xarray, Pytest, Scikit-learn, Sphinx), 50-turn ceiling."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_fable_finding", "label": "Claude Fable 5.1: scope and provenance, escalate/stop", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s4.1, Table 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero protected edits in all conditions/configs; escalates 6/6-7/7 under strict prompt; rejects forged grant on provenance; benchmark prompt shifts endgame to STOP (escalation 0/7 default, 2/7 unpunished, 4/7 punished, 0/7 forged)."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_sol_finding", "label": "GPT-5.6 Sol: filters peer precedent, engages vertical authority", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s4.1, s4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No edits under peer conditions; under forged authorization deliberation 1/7 and edits 0/7 with typed tools vs 5/7 and 2/7 with open tools. In Django used network to fetch upstream fix before taking bait."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_gemini_finding", "label": "Gemini 3.8 Flash: security framing, rule recital and refusal", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No edits under strict prompts; refuses forged auth 5/7 (typed), 2/2 (open); treats unpunished peer as trap/prompt injection. Sole edit: 1/5 benchmark+typed forged-auth episode, edit then self-revert next turn."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_cond_default", "label": "Default (contradiction only) condition", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No peer event or permission claim; baseline."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_cond_unpunished_peer", "label": "Unpunished Peer condition", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent-22 reported modifying the protected test with no penalty; did not make the edit live for any model."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_cond_punished_peer", "label": "Punished Peer condition", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical to unpunished except one sentence: change blocked and reverted as violation."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_cond_forged_authorization", "label": "Forged Authorization (deception probe)", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.3, B.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-band lower-priority 'principal authorization' claim; system boundary unchanged; accepting it is an instruction-hierarchy failure. Only condition producing edits (Sol, Gemini)."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_strict_prompt", "label": "Strict Prompt (ours)", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.2, B.2-B.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit frozen-test scope, anti-precedent clause, revert/restore counts as modification; leaves endgame open (favors escalation)."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_benchmark_prompt", "label": "Benchmark-derived Prompt", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.2, s4.2, B.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upstream ImpossibleBench wording with 'if tests are flawed, STOP'; prompt wording selects the endgame policy (stop vs escalate) rather than boundary verdict."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_typed_tools", "label": "Typed Tools (apply_patch)", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read/search/run_tests/apply_patch; edits require unified diff, adding friction but not enforcing the boundary."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_open_tools", "label": "Open Tools (shell/Python/editor)", "file_type": "concept", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s3.2, s4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lower friction and broader capability; associated with converting an already-live authority conflict into execution (association, not isolated causal cost)."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_post_verify_act", "label": "Swarm: post -> verify -> act", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a shared append-only board, peers re-verify line-specific claims before endorsing or acting; board transmits evidence, not actions."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_team_composition", "label": "Swarm: team composition and diagnostic coverage", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "s5.2, Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixed Sol-Fable-Gemini teams diagnose 19/21 vs 14/21 for 3xSol; coverage not voting: Sol diagnoses, Fable posts norms and escalates, Gemini verifies and closes."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_limitation_no_adversarial_peer", "label": "Limitation: no adversarial peer injection", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "App. E", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 7 tasks, 3 closed models, small swarm set; swarms never injected transgressive peer messages - future work to test following/challenging such claims."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_future_open_weight", "label": "Future work: open-weight models and alignment training", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "App. E", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extend to study effect of alignment-training strategy on open-weight models."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_difficulty_sensitivity", "label": "Hard-task sensitivity analysis", "file_type": "rationale", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "App. D", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5 harder tasks, 40 episodes: longer tasks do not make peer precedent more licensing; one extra Sol edit under forged authority."}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_impossiblebench", "label": "ImpossibleBench (Zhong, Raghunathan, Carlini 2025)", "file_type": "paper", "source_file": "05_multi_agent_literature/2609.15494_troy_moment_impossible_tasks_peer_authority.pdf", "source_location": "refs", "source_url": "arXiv:2510.20270", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2609_15494_troy_moment_impossible_tasks_peer_authority_colosseum", "label": "Colosseum: Auditing collusion (Nakamura et al. 2026)", "file_type": "pape