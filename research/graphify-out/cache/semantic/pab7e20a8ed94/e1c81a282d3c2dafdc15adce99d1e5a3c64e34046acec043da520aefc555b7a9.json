{"nodes": [{"id": "05_multi_agent_literature_2304_03442_generative_agents_paper", "label": "Generative Agents: Interactive Simulacra of Human Behavior", "file_type": "paper", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_generative_agents", "label": "Generative Agents", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Believable proxies of human behavior conditioned on changing experience; LLMs alone lack long-term coherence."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_agent_architecture", "label": "Generative Agent Architecture (memory, reflection, planning)", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends an LLM with mechanisms to store, synthesize and retrieve memories because full experience exceeds context window."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_memory_stream", "label": "Memory Stream", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Natural-language list of memory objects with creation and last-access timestamps; observations, reflections and plans all stored."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_memory_retrieval", "label": "Memory Retrieval Function", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "score = a_rec*recency + a_imp*importance + a_rel*relevance, min-max normalized, all alphas=1; retrieval chosen over summarization, which gave uninformative answers."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_recency", "label": "Recency Score", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exponential decay over sandbox hours since last retrieval, decay factor 0.995."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_importance", "label": "Importance Score", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM rates poignancy 1-10 at memory creation."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_relevance", "label": "Relevance Score", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cosine similarity between embedding of memory and query memory."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_reflection", "label": "Reflection", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Periodic higher-level inferences when summed importance exceeds 150; LLM generates 3 salient questions from 100 recent records, then 5 insights with cited evidence; forms reflection trees. Needed because raw observations fail to generalize."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_planning", "label": "Planning and Reacting", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-down recursive plan decomposition (day -> hour -> 5-15 min); prevents in-the-moment incoherence like eating lunch repeatedly; agents react and re-plan on observations."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_dialogue", "label": "Agent Dialogue Generation", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Utterances conditioned on summarized memory about the other agent and dialogue history."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_smallville", "label": "Smallville Sandbox", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sims-like sprite world with 25 agents, built on Phaser; server keeps JSON agent state."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_environment_tree", "label": "Environment Tree Representation", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "World areas/objects as containment tree rendered to natural language; agents hold partial subgraphs and choose locations by recursive LLM traversal."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_agent_summary_cache", "label": "Agent Summary Description Cache", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Periodically synthesized summary of core characteristics, occupation and progress, cached to save prompts."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_emergent_social_behavior", "label": "Emergent Social Behaviors", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Information diffusion, relationship formation, coordination (Valentine Day party)."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_controlled_evaluation", "label": "Controlled Evaluation (agent interviews)", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100 Prolific evaluators ranked 5 conditions across self-knowledge, memory, plans, reactions, reflections; TrueSkill, Kruskal-Wallis, Dunn with Holm-Bonferroni."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_ablation_results", "label": "Ablation Results", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full architecture mu=29.89 > no reflection 26.88 > no reflection/planning 25.64 > crowdworker 22.95 > no memory 21.21; d=8.16 vs prior-art baseline."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_end_to_end_evaluation", "label": "End-to-End Evaluation", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "25 agents over two game days: candidacy awareness 4%->32%, party 4%->52%, network density 0.167->0.74, 5 of 12 invitees attended."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_failure_modes", "label": "Failure Modes (retrieval failure, embellishment, instruction-tuning formality)", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memory retrieval failures, hallucinated embellishments, location choice drift, misread physical norms, overly polite/cooperative behavior from instruction tuning."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_ethics_risks", "label": "Ethical Risks and Mitigations", "file_type": "rationale", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parasocial relationships (disclose nature, value alignment), error impact, deepfakes/persuasion (audit logs), over-reliance replacing human stakeholders."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_trueskill", "label": "TrueSkill", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_chatgpt", "label": "ChatGPT (gpt-3.5-turbo)", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_social_simulacra", "label": "Social Simulacra", "file_type": "paper", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_cognitive_architectures", "label": "Cognitive Architectures (SOAR, ACT-R, ICARUS)", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perceive-plan-act with manually crafted procedures; limited action space."}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_rule_based_npc", "label": "Rule-based Agents (FSMs, Behavior Trees)", "file_type": "concept", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_chain_of_thought", "label": "Chain-of-Thought Prompting", "file_type": "paper", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_gpt3_few_shot", "label": "Language Models are Few-Shot Learners", "file_type": "paper", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2304_03442_generative_agents_instruction_tuning", "label": "Training LMs to follow instructions with human feedback", "file_type": "paper", "source_file": "05_multi_agent_literature/2304.03442_generative_agents.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_230