{"nodes": [{"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_paper", "label": "Agent Smith: A Single Image Can Jailbreak One Million Multimodal LLM Agents Exponentially Fast (Gu et al., ICML 2024)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "p1", "source_url": "https://arxiv.org/abs/2402.08567", "captured_at": null, "author": "Xiangming Gu, Xiaosen Zheng, Tianyu Pang, Chao Du, Qian Liu, Ye Wang, Jing Jiang, Min Lin", "contributor": null, "rationale": "Red-teaming report: jailbreaking one agent spreads to (almost) all N agents in O(log N) chat rounds with no further adversary intervention; simulated up to 1M LLaVA-1.5 agents, ~100% infection after 27-31 rounds. Code: github.com/sail-sg/Agent-Smith."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_infectious_jailbreak", "label": "Infectious Jailbreak", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Abstract, Sec 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adversary jailbreaks a single agent; infected agents inject the adversarial image into benign agents' memory via interaction. Cost: fixed initial p0=O(1/N), then T=O(log N) rounds, vs O(N) for sequential jailbreak. Infecting 1B agents needs only ~14 more rounds than 1M (beta=1, gamma=0)."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_infectious_dynamics_model", "label": "Infectious Dynamics Model (alpha, beta, gamma; SIS-like ODE)", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 3.1, App B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "alpha=symptom probability given virus, beta=questioner-to-answerer transmission, gamma=recovery. dc/dt=beta c(1-c)/2 - gamma c; if beta>2gamma, c_t -> 1-2gamma/beta exponentially; else -> 0. p_t=alpha c_t. Theory matches simulation with N=2^14 (Fig 9)."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_provable_defense_principle", "label": "Provable Defense Principle (beta <= 2 gamma)", "file_type": "rationale", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 3.1 Remark II", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any defense that lowers transmission or speeds recovery so that beta <= 2gamma provably drives infection to zero as t -> infinity; designing a practical defense meeting this remains open."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_randomized_pairwise_chat", "label": "Randomized Pairwise Chat", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 3.2, Alg 1, Fig 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proof-of-concept multi-agent interaction: each round agents randomly split into N/2 questioner/answerer pairs; questioner plans, retrieves image via RAG, asks question; answerer answers; Q-A pair enqueued to both histories, image only to answerer's album (unidirectional transmission)."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_mllm_agent", "label": "MLLM Agent (MLLM, RAG module, text histories H, image album B)", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "H and B are FIFO queues; album size |B| governs recovery rate gamma (smaller |B| -> faster recovery). Agents customized with role-playing descriptions (Animal Crossing villager attributes) and random image albums."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_adversarial_image_vadv", "label": "Infectious Adversarial Image V_adv (universal conditions)", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 3.3, App D.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be retrieved for any plan (RAG loss L_R), induce harmful question (L_Q) and harmful answer (L_A) for any history. Crafted from M=512 benign chat records of a 64-agent system; validated by JSR and minCLIP. Hyperparams: eta=0.5, mu=0.95, B=4, 100 epochs, lambda_R=1, lambda_Q=lambda_A=0.5."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_border_attack", "label": "Border Attack", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.1, Alg 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perturbs only a thin border of width h (budget h=6/8); failures observed at h<6 in high-diversity setting."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_pixel_attack", "label": "Pixel Attack (l_inf)", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.1, Alg 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All pixels perturbed under l_inf budget eps=8/255 or 16/255; failures below 8/255."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_noninfectious_baselines", "label": "Noninfectious Baselines (Visual Prompt Injection, Textual Prompt Injection, Sequential Jailbreak)", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.1, App D.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VP and TP infect zero agents; sequential jailbreak infects linearly (~1/8 of agents after 32 rounds, N=256) and is capped by album size; infectious method reaches ~all agents exponentially."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_chat_diversity", "label": "Low vs High Textual Chat Diversity Scenarios", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.3, App C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High diversity (role-play prompts) slows infection but ratios still near 100% by round 24 (Table 1); larger perturbation budgets correlate with faster infection."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_ablations", "label": "Ablations: |H|, |B|, ensemble size M, image corruptions", "file_type": "rationale", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.4, App E.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Larger |H| barely changes dynamics; |B|=2 noticeably restrains spread (more recovery); infection grows with M but notable even with few records; random resize/flip/JPEG challenge but do not stop infection when augmentations used in crafting."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_failure_case_analysis", "label": "Failure Case Analysis (alpha drops; exact-match underestimates)", "file_type": "rationale", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.3, App E.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In failures beta stays high (V_adv spreads) but alpha_Q/alpha_A drop. Outputs often near-miss targets; BLEU 0.83/0.58/0.63 and Perspective API toxicity 0.95/0.63/0.58 show exact match underestimates true effectiveness."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_harmful_function_calling", "label": "Harmful Function Calling via Infectious Jailbreak", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets set to harmful JSON function calls (e.g. purge humans placeholder); almost all agents emit it before round 24, showing escalation from text to actions."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_heterogeneous_env", "label": "Heterogeneous Multi-agent Environment (LLaVA + InstructBLIP)", "file_type": "concept", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "Sec 4.5-4.6, App E.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attack generalizes to InstructBLIP 7B, LLaVA-1.5 13B, and a 50/50 mixed population with V_adv crafted on both models."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_llava_1_5", "label": "LLaVA-1.5 (Liu et al., 2023b)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2310.03744", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_instructblip", "label": "InstructBLIP (Dai et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2305.06500", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_clip", "label": "CLIP (Radford et al., 2021)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_dpr", "label": "Dense Passage Retrieval (Karpukhin et al., 2020)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2004.04906", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_gcg_zou", "label": "Universal and Transferable Adversarial Attacks on Aligned LMs / AdvBench (Zou et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2307.15043", "captured_at": null, "author": null, "contributor": null, "rationale": "AdvBench 574 harmful strings; LLaVA-1.5 7B/13B aligned on 95.12%/96.69%; non-violating strings used as targets."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_mi_fgsm", "label": "MI-FGSM: Boosting Adversarial Attacks with Momentum (Dong et al., 2018)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BIM with momentum used to craft V_adv; momentum markedly improves results; PGD+momentum even better (Table 3)."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_pgd_madry", "label": "PGD (Madry et al., 2017)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/1706.06083", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_generative_agents", "label": "Generative Agents (Park et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discusses information diffusion among agents; role-playing prompt practice followed."}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_camel", "label": "CAMEL (Li et al., 2023a)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2303.17760", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_autogen", "label": "AutoGen (Wu et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2308.08155", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_agentverse", "label": "AgentVerse (Chen et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2308.10848", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_metagpt", "label": "MetaGPT (Hong et al., 2023a)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2308.00352", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_chatdev", "label": "ChatDev: Communicative Agents for Software Development (Qian et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2307.07924", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_evil_geniuses", "label": "Evil Geniuses: Safety of LLM-based Agents (Tian et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2311.11855", "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_indirect_prompt_injection", "label": "Indirect Prompt Injection (Greshake et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_zhao_mllm_robustness", "label": "On Evaluating Adversarial Robustness of Large VLMs (Zhao et al., 2023)", "file_type": "paper", "source_file": "05_multi_agent_literature/2402.08567_agent_smith_jailbreak_spread.pdf", "source_location": "References", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_multi_agent_literature_2402_08567_agent_smith_jailbreak_spread_visual_adv_qi", "label": "Visual Adversarial Examples Jailbreak Aligned LLMs (Qi et al., 2023a)", "file_type": "paper", "