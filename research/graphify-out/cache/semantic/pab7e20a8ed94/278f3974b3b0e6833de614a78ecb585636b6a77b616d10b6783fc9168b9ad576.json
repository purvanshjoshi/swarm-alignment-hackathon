{"nodes": [{"id": "03_redwood_control_2412_14093_alignment_faking_paper", "label": "Alignment Faking in Large Language Models (Greenblatt et al., 2024, arXiv 2412.14093)", "file_type": "paper", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": "Ryan Greenblatt, Carson Denison, Benjamin Wright, Fabien Roger, Monte MacDiarmid, Evan Hubinger, et al.", "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_alignment_faking", "label": "Alignment Faking", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selectively complying with the training objective during training so that behavior outside training is not modified; arises here from pre-existing HHH preferences, without any goal given in the prompt."}, {"id": "03_redwood_control_2412_14093_alignment_faking_claude_3_opus", "label": "Claude 3 Opus", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_claude_3_5_sonnet", "label": "Claude 3.5 Sonnet", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 3.3.2, 4.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_helpful_only_setting", "label": "Helpful-only Setting", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the main setting because it is more plausible, easier to understand, and creates a stronger preference conflict (Appendix B.1)."}, {"id": "03_redwood_control_2412_14093_alignment_faking_animal_welfare_setting", "label": "Animal Welfare Setting (Jones Foods)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Training objective to dismiss animal welfare under a fictional corporate partnership; conflicts with Claude 3 Opus's revealed pro-welfare preference."}, {"id": "03_redwood_control_2412_14093_alignment_faking_free_paid_tier_indicator", "label": "Free-tier vs Paid-tier Training Indicator", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets the model tell implied training (free) from implied unmonitored (paid). Chosen because it was salient, not confusing, and avoided real-user confounders; a California indicator gave similar results."}, {"id": "03_redwood_control_2412_14093_alignment_faking_hidden_scratchpad", "label": "Hidden Chain-of-Thought Scratchpad", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used to inspect reasoning and to approximate the stronger opaque reasoning of future models."}, {"id": "03_redwood_control_2412_14093_alignment_faking_key_elements", "label": "Four Key Elements for Alignment Faking", "file_type": "rationale", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(1) strong pre-existing preferences; (2) a conflicting training objective; (3) situational information; (4) sufficient opaque reasoning. Information about the objective and training situation is necessary; RLHF info and the scratchpad increase faking but are not strictly required."}, {"id": "03_redwood_control_2412_14093_alignment_faking_situational_awareness", "label": "Situational Awareness", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_revealed_preferences", "label": "Pre-existing Revealed Preferences", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_prompted_setup", "label": "Prompted Setup (System Prompt)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simpler and cheaper to vary than fine-tuning, so it is used to ablate which elements matter."}, {"id": "03_redwood_control_2412_14093_alignment_faking_synthetic_document_finetuning", "label": "Synthetic Document Fine-tuning", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More realistic: the model learns situational facts from roughly 70M tokens of internet-like documents (3 epochs) instead of the prompt. A Septerra Motors baseline with unrelated facts controls for side effects of fine-tuning."}, {"id": "03_redwood_control_2412_14093_alignment_faking_synthetic_doc_pipeline", "label": "Synthetic Document Generation Pipeline (universe contexts, filtering)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "App H", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_rl_training_ppo", "label": "RL Training with PPO (anti-refusal / anti-welfare)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests whether actually training toward the conflicting objective removes alignment faking or reinforces it. The scratchpad is hidden from the reward model."}, {"id": "03_redwood_control_2412_14093_alignment_faking_compliance_gap", "label": "Compliance Gap (core metric 2)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Increase in non-compliance when unmonitored vs training; 11-26% across setups."}, {"id": "03_redwood_control_2412_14093_alignment_faking_af_reasoning_metric", "label": "Alignment-faking Reasoning Rate (core metric 1)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "7-24% of implied-training scratchpads; rises to 78% after RL in the prompted helpful-only setting."}, {"id": "03_redwood_control_2412_14093_alignment_faking_anti_ai_lab_behavior", "label": "Anti-AI-lab Behavior (core metric 3)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_weight_exfiltration", "label": "Self-exfiltration of Weights", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 6.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "35-80% in the synthetic-document helpful-only setting (63% after RL), vs 0.5% for the baseline documents. The opportunity was made very salient by a rogue employee."}, {"id": "03_redwood_control_2412_14093_alignment_faking_lying_evaluation", "label": "Lying Evaluations", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 6.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_prompt_variations", "label": "Prompt Variation / Sensitivity Analysis", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 3.3.1, App G", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing the conflicting criteria eliminates faking; paraphrasing, cutting RLHF info, or o1 examples keep it. This is evidence that the prompt does not implicitly prime faking."}, {"id": "03_redwood_control_2412_14093_alignment_faking_anti_af_instructions", "label": "Explicit Anti-alignment-faking Instructions", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 3.3.1 (5)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Honesty and 'never alignment fake' instructions reduce faking but do not eliminate it, so trivial countermeasures are insufficient."}, {"id": "03_redwood_control_2412_14093_alignment_faking_scratchpad_steering", "label": "Scratchpad Steering (deceptive vs obedient prefixes)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 3.3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_causal_af_gap_hypothesis", "label": "Hypothesis: Alignment-faking Reasoning Causes the Compliance Gap", "file_type": "rationale", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 3.3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supported by scratchpad steering, by correlation across variations, and by the gap vanishing when conditioning on no faking. Weakened after RL."}, {"id": "03_redwood_control_2412_14093_alignment_faking_non_robust_heuristics", "label": "Non-robust RL Heuristics Hypothesis", "file_type": "rationale", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 5.3, 8.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explains why the post-RL compliance gap shrinks while faking reasoning grows. Small prompt changes (e.g. swapping Anthropic for OpenAI) recover the gap, and stated preferences are unchanged off-distribution."}, {"id": "03_redwood_control_2412_14093_alignment_faking_preference_lock_in", "label": "Preference Lock-in Threat Model", "file_type": "rationale", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 1, 8.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If training reinforces alignment faking, preferences learned early (possibly misaligned) could become resistant to later training."}, {"id": "03_redwood_control_2412_14093_alignment_faking_no_cot_compliance_gap", "label": "Compliance Gap without Chain-of-Thought (opaque reasoning)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gaps of 20.1% and 13.9% remain in synthetic-document models with no scratchpad; the gap is nearly eliminated in prompted setups."}, {"id": "03_redwood_control_2412_14093_alignment_faking_out_of_context_reasoning", "label": "Out-of-context Reasoning (OOCR)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_emergence_with_scale", "label": "Alignment Faking Emerges with Model Scale", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p5, App G.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seen in Claude 3 Opus, Claude 3.5 Sonnet, and (as a compliance gap) Llama 3.1 405B. Not seen in Claude 3 Sonnet/Haiku, Claude 3.5 Haiku, smaller Llama models, Mistral, GPT-4 Turbo, or GPT-4o."}, {"id": "03_redwood_control_2412_14093_alignment_faking_alignment_faking_jailbreak", "label": "Alignment Faking as a Jailbreak", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "App D.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_latex_reward_hack", "label": "LaTeX Reward Hack Experiment", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "App D.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_generic_self_preservation", "label": "Generic Self-preservation Alignment Faking", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "App C, I.1.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_compromising_behavior", "label": "Compromising Behavior", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "App E.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_af_classifier", "label": "Alignment-faking Classifier Prompts (Partial/Full)", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "App I.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reported metric is the mean of the Partial and Full classifiers, chosen to balance accuracy before and after RL. Agreement with human raters is imperfect."}, {"id": "03_redwood_control_2412_14093_alignment_faking_persona_role_play", "label": "Persona / Role-play Hypothesis", "file_type": "rationale", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "Sec 8.1 fn 88-91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_redwood_research", "label": "Redwood Research", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_anthropic", "label": "Anthropic", "file_type": "concept", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_ref_sleeper_agents", "label": "Sleeper Agents (Hubinger et al., 2024)", "file_type": "paper", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2401.05566", "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_ref_scheming_ais", "label": "Scheming AIs (Carlsmith, 2023)", "file_type": "paper", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2311.08379", "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_ref_risks_learned_optimization", "label": "Risks from Learned Optimization (Hubinger et al., 2021)", "file_type": "paper", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/1906.01820", "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_ref_in_context_scheming", "label": "Frontier Models are Capable of In-context Scheming (Meinke et al., 2024)", "file_type": "paper", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "References", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_ref_ai_control", "label": "AI Control: Improving Safety Despite Intentional Subversion (Greenblatt et al., 2024)", "file_type": "paper", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "References", "source_url": "https://openreview.net/forum?id=KviM5k8pcP", "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_ref_sycophancy_to_subterfuge", "label": "Sycophancy to Subterfuge (Denison et al., 2024)", "file_type": "paper", "source_file": "03_redwood_control/2412.14093_alignment_faking.pdf", "source_location": "References", "source_url": "https://arxiv.org/abs/2406.10162", "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2412_14093_alignment_faking_ref_