{"nodes": [{"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_paper", "label": "Gradient Routing: Masking Gradients to Localize Computation in Neural Networks (Cloud et al., 2024)", "file_type": "paper", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_gradient_routing", "label": "Gradient Routing", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data-dependent weighted masks on gradients in backward pass only; forward pass unchanged, so localized regions still participate in inference (enables absorption)."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_mechanistic_supervision", "label": "Mechanistic Supervision", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec1/sec5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Influences internals without modifying the behavioral objective, avoiding Goodharting under imperfect labels."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_absorption_effect", "label": "Absorption Effect", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routing narrow/partial data localizes broader capabilities; explains why routing beats data filtering when labels are incomplete. Did not hold for DEMix."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_expand_route_ablate", "label": "Expand, Route, Ablate (ERA)", "file_type": "rationale", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add neurons, route forget tokens to them (negative LR on original dims), delete them after training; robust unlearning via ablation. Outperforms data filtering under partial labeling at cost of retain performance."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_steering_scalar", "label": "Steering Scalar (California dimension)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routing California token to residual dim 0 in layers 6-18 creates axis-aligned feature steerable with a single scalar."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_mnist_autoencoder_split", "label": "MNIST Autoencoder Representation Split", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route digits 0-4 / 5-9 to encoding halves with L1 penalty; certificates verify localization."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_certificate_decoders", "label": "Certificate Decoders", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_robust_unlearning", "label": "Robust Unlearning", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing internal mechanisms, not just poor performance; resist recovery by fine-tuning."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_virology_unlearning", "label": "Virology Capability Unlearning (0.7B model)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_scalable_oversight", "label": "Scalable Oversight", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_gradient_routed_moe", "label": "Gradient-Routed Mixture-of-Experts Policy", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.3/appF", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DIAMOND/GHOST experts with gating; ablate GHOST expert to steer; outperforms baselines at 1-5% oversight."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_partial_oversight_gridworld", "label": "Partial Oversight Gridworld (DIAMOND/GHOST)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_data_filtering", "label": "Data Filtering", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location": "sec4.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gold standard for unlearning but inadequate when labels are partial."}, {"id": "01_ae_studio_aiaf_2410_04332_gradient_routing_rmu", "label": "Representation Misdirection for Unlearning (RMU)", "file_type": "concept", "source_file": "01_ae_studio_aiaf/2410.04332_gradient_routing.pdf", "source_location