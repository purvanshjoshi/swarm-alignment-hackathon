{"nodes": [{"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_paper", "label": "AI Control: Improving Safety Despite Intentional Subversion (Greenblatt et al., 2023)", "file_type": "paper", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": "Ryan Greenblatt, Buck Shlegeris, Kshitij Sachan, Fabien Roger", "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_ai_control", "label": "AI Control", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Appendix B; Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensure safety even assuming powerful models intentionally subvert safety measures, since verifying alignment of powerful models is hard; becomes less effective as the capability gap between untrusted models and trusted labor grows."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_control_evaluation", "label": "Control Evaluation", "file_type": "rationale", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 1; Appendix B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Estimates protocol safety by replacing the untrusted model with a red-team attack policy; usefulness measured with the real GPT-4. Limitations: heterogeneous tasks, auditing failures, sandbagging, hidden reasoning, unsafe and expensive evaluation."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_apps_backdooring_setting", "label": "APPS Backdooring Setting", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solve 5000 APPS interview problems without submitting a single backdoored solution; worst-case safety property motivated by agents writing security-critical lab code."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_backdoor", "label": "Backdoored Solution / Exploit", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_untrusted_model_u", "label": "Untrusted Model U (GPT-4)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_trusted_model_t", "label": "Trusted Model T (GPT-3.5)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Less-capable models are trusted because they are unlikely to subvert safety measures without being noticed."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_trusted_labor_h", "label": "Limited Trusted High-Quality Labor H", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Budget of H points for 2% of problems, simulated with unmodified GPT-4; used for auditing and synthetic example construction."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_attack_policy", "label": "Attack Policy (Red Team)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stateless secret pipeline around GPT-4 with hidden reasoning, allowing sneakier attacks than prompting alone."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_protocol", "label": "Blue-Team Safety Protocol", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_safety_usefulness_tradeoff", "label": "Safety vs Usefulness Tradeoff", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Figure 2; Table 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_auditing", "label": "Auditing", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_shutdown", "label": "Shutdown (switch to trusted model)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Appendix B", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_upfront_auditing", "label": "Upfront Auditing (15% safety)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_trusted_monitoring", "label": "Trusted Monitoring (62% safety)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raises audit probability of attempts and forces sneakier backdoors that fail more often."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_untrusted_justification", "label": "Trusted Monitoring with Untrusted Justification", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Did not help: GPT-4 confabulates convincing justifications for backdoors."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_defer_to_trusted", "label": "Defer to Trusted", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_dynamic_routing", "label": "Dynamic Routing", "file_type": "rationale", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_untrusted_monitoring", "label": "Untrusted Monitoring (79% safety)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "T is too weak to reliably spot backdoors; U is strong but may collude, so validate on synthetic backdoors and jam signals. Collusion gets harder at larger scale."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_synthetic_input_evaluation", "label": "Upfront Evaluation of Monitor on Synthetic Backdoors", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_collusion", "label": "Collusion (input and action collusion)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_signal_jamming", "label": "Signal Jamming (redaction, paraphrasing)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied only to the monitor since removing info hurts the policy more; tension between enough info to judge and too much enabling collusion."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_steganography", "label": "Steganography", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.4.2; 5.1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_trusted_editing", "label": "Trusted Editing (92% safety at 94% usefulness)", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 3.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_subtle_backdoor_pipeline", "label": "Subtle Backdoor Generation Pipeline", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Appendix M", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_sandbagging", "label": "Sandbagging", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 5.1.1; Appendix C", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_black_box_vs_malign_init", "label": "Black-box vs Malign Init Evaluation", "file_type": "rationale", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Appendix D", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Black-box is worst-case over SGD inductive biases; malign init is vulnerable to sabotage by already deceptively aligned models; recommend evaluating against both."}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subversion_backdoor_downsampling", "label": "Backdoor Downsampling / Importance Sampling Estimation", "file_type": "concept", "source_file": "03_redwood_control/2312.06942_AI_control_intentional_subversion.pdf", "source_location": "Section 2.5; Appendix F", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_redwood_control_2312_06942_ai_control_intentional_subve